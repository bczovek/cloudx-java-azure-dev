az login

tempResourceGroup="temporary_rg1"
tempRg1Location="northeurope"

az group create --name $tempResourceGroup --location "$tempRg1Location"

cosmosDbAccountName="cosmosdb$RANDOM"

az cosmosdb create --name "$cosmosDbAccountName" --resource-group "$tempResourceGroup"

cosmosDatabaseName="petstoreorderservice"

az cosmosdb sql database create --account-name "$cosmosDbAccountName" --resource-group "$tempResourceGroup" --name "$cosmosDatabaseName"

az cosmosdb sql container create --account-name "$cosmosDbAccountName" --resource-group "$tempResourceGroup" --database-name "$cosmosDatabaseName" --name "orders" --partition-key-path "/id"

acrName="petstoreacr9084"

az acr login --name "$acrName"

az acr build --image petstoreapp:latest --registry "$acrName" --file petstoreapp/Dockerfile petstoreapp/
az acr build --image petstoreorderservice:latest --registry "$acrName" --file petstoreorderservice/Dockerfile petstoreorderservice/
az acr build --image petstorepetservice:latest --registry "$acrName" --file petstorepetservice/Dockerfile petstorepetservice/
az acr build --image petstoreproductservice:latest --registry "$acrName" --file petstoreproductservice/Dockerfile petstoreproductservice/

az appservice plan create --name petstoreappPlan --resource-group "$tempResourceGroup" --is-linux --location "$tempRg1Location" --sku P1V2

az webapp create --name petstoreapp1 --plan petstoreappPlan --resource-group "$tempResourceGroup" --deployment-container-image-name "$acrName.azurecr.io/petstoreapp:latest" 

orderServiceName="petstoreorderservice$RANDOM"
petServiceName="petstorepetservice$RANDOM"
productServiceName="petstoreproductservice$RANDOM"

az webapp create --name "$orderServiceName" --plan petstoreappPlan --resource-group "$tempResourceGroup" --deployment-container-image-name "$acrName.azurecr.io/petstoreorderservice:latest"
az webapp create --name "$petServiceName" --plan petstoreappPlan --resource-group "$tempResourceGroup" --deployment-container-image-name "$acrName.azurecr.io/petstorepetservice:latest"
az webapp create --name "$productServiceName" --plan petstoreappPlan --resource-group "$tempResourceGroup" --deployment-container-image-name "$acrName.azurecr.io/petstoreproductservice:latest"

az webapp config appsettings set --name petstoreapp1 --resource-group "$tempResourceGroup" --settings PETSTOREPETSERVICE_URL="https://$petServiceName.azurewebsites.net" PETSTOREPRODUCTSERVICE_URL="https://$productServiceName.azurewebsites.net" PETSTOREORDERSERVICE_URL=https://$orderServiceName.azurewebsites.net WEBSITES_PORT=8080

az webapp identity assign --name "$orderServiceName" --resource-group "$tempResourceGroup"

principalId=$(az webapp identity show --name "$orderServiceName" --resource-group "$tempResourceGroup" --query principalId --output tsv)

subscriptionId=$(az account show --query id --output tsv)

cosmosScope="/subscriptions/$subscriptionId/resourceGroups/$tempResourceGroup/providers/Microsoft.DocumentDB/databaseAccounts/$cosmosDbAccountName"

az cosmosdb sql role assignment create --account-name "$cosmosDbAccountName" --principal-id "$principalId" --resource-group "$tempResourceGroup" --scope "$cosmosScope" --role-definition-id 00000000-0000-0000-0000-000000000002

cosmosDbEndpoint=$(az cosmosdb show --name $cosmosDbAccountName --resource-group $tempResourceGroup --query documentEndpoint --output tsv)

az webapp config appsettings set --name "$orderServiceName" --resource-group "$tempResourceGroup" --settings PETSTOREPRODUCTSERVICE_URL="https://$productServiceName.azurewebsites.net" ORDERDATABASE_URL="$cosmosDbEndpoint" ORDERDATABASE_NAME="$cosmosDatabaseName" WEBSITES_PORT=8080

petstoreDbName="petstoredb$RANDOM"

adminUser="petstoreDbAdmin"
adminPassword="petstoreDbPassword"

az postgres flexible-server create --resource-group "$tempResourceGroup" --name "$petstoreDbName" --location "$tempRg1Location" --admin-user "$adminUser" --admin-password "$adminPassword" --sku-name Standard_D4ds_v4 --public-access 0.0.0.0
 
az postgres flexible-server db create \
  --resource-group "$tempResourceGroup" \
  --server-name "$petstoreDbName" \
  --database-name "petstoreproductservice_db"

az postgres flexible-server db create \
  --resource-group "$tempResourceGroup" \
  --server-name "$petstoreDbName" \
  --database-name "petstorepetservice_db"

myIp=$(curl -s https://api.ipify.org)

az postgres flexible-server firewall-rule create \
  --resource-group "$tempResourceGroup" \
  --name "$petstoreDbName" \
  --rule-name AllowMyPC \
  --start-ip-address "$myIp" \
  --end-ip-address "$myIp"

postgresUrl="$(az postgres flexible-server show --resource-group "$tempResourceGroup" --name "$petstoreDbName" --query "fullyQualifiedDomainName" -o tsv)"

sudo -u postgres psql "host=$postgresUrl user=$adminUser dbname=petstoreproductservice_db password=$adminPassword sslmode=require" < ../content/modules/module-07-databases/scripts/productservice.sql

sudo -u postgres psql "host=$postgresUrl user=$adminUser dbname=petstorepetservice_db password=$adminPassword sslmode=require" < ../content/modules/module-07-databases/scripts/petservice.sql

productDbConnUrl="postgresql://$postgresUrl:5432/petstoreproductservice_db?sslmode=require"

petDbConnUrl="postgresql://$postgresUrl:5432/petstorepetservice_db?sslmode=require"

az webapp config appsettings set --name "$productServiceName" --resource-group "$tempResourceGroup" --settings WEBSITES_PORT=8080 POSTGRES_USERNAME=petstore_user POSTGRES_PASSWORD=petstore_password POSTGRES_URL="$productDbConnUrl"

az webapp config appsettings set --name "$petServiceName" --resource-group "$tempResourceGroup" --settings WEBSITES_PORT=8080 POSTGRES_USERNAME=petstore_user POSTGRES_PASSWORD=petstore_password POSTGRES_URL="$petDbConnUrl"

az webapp restart --name "$productServiceName" --resource-group "$tempResourceGroup"

az webapp restart --name "$petServiceName" --resource-group "$tempResourceGroup"